# ── Enki Framework .gitignore ────────────────────────────────

# Build directories
build/
build_*/
bin/
out/
dist/

# Meson / Ninja artifacts
.ninja_log
.ninja_deps
meson-private/
meson-info/
meson-logs/
compile_commands.json
*.p/

# CEF Binary Distributions (Heavy binary assets - download on setup)
web_technology/cef_binary/
web_technology/cef_binary/cef_binary_*/build/
*.tar.bz2
*.tar.gz
*.tar.xz
*.zip

# Compiled Object Files & Libraries
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe

# Runtime Caches & Temporary Files
.cache/
*.log
*.tmp
*.swp
*.swo
*~

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
