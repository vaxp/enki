# ── Enki Framework .gitignore ────────────────────────────────

# Build directories
build/
build_*/
bin/
out/
dist/

# Meson / Ninja artifacts
.ninja_log
.ninja_deps
meson-private/
meson-info/
meson-logs/
compile_commands.json
*.p/

# CEF & FFmpeg Binary Distributions (Heavy binary assets - download on setup)
modules/web_technology/cef_binary/
modules/web_technology/cef_binary/cef_binary_*/build/
core/ffmpeg-windows/
*.tar.bz2
*.tar.gz
*.tar.xz
*.zip

# Compiled Object Files & Libraries
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe

# Whitelist Prebuilt Skia Release Binaries
!core/skia/out/
!core/skia/out/Release-wasm/
!core/skia/out/Release-wasm/*.a
!core/skia/out/Release-x64/*.a
!core/Skia-Windows/out/
!core/Skia-Windows/out/Release-x64/
!core/Skia-Windows/out/Release-x64/*

# Runtime Caches & Temporary Files
.cache/
scratch/
cef_b/
*.log
*.tmp
*.swp
*.swo
*~

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
