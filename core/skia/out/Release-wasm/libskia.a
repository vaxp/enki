<head>
   <title>SkVM Disassembler Output</title>
   <style>
   button { border-style: none; font-size: 10px; background-color: lightpink; }
   table { text-align: left; }
   table th { background-color: lightgray; }
   .dead, .dead1 { color: lightgray; text-decoration: line-through; }
   .normal, .normal1 { }
   .origin, .origin1 { font-weight: bold; }
   .source, .source1 { color: darkblue; }
   .mask, .mask1 { color: green; }
   .comments, .comments1 { }
   .machine, .machine1 { color: lightblue; }
   </style>
    <script>
    function initializeButton(className) {
      var btn = document.getElementById(className);
      var elems = document.getElementsByClassName(className);
      if (elems == undefined || elems.length == 0) {
        btn.disabled = true;
        btn.innerText = "None";
        btn.style.background = "lightgray";
        return;
      }
    };
    function initialize() {
      initializeButton('normal');
      initializeButton('source');
      initializeButton('dead');
      initializeButton('machine');
    };
  </script>
</head>
<body onload='initialize();'>
    <script>
    function toggle(btn, className) {
      var elems = document.getElementsByClassName(className);
      for (var i = 0; i < elems.length; i++) {
        var elem = elems.item(i);
        if (elem.style.display === "") {
            elem.style.display = "none";
            btn.innerText = "Show";
            btn.style.background = "lightcyan";
        } else {
            elem.style.display = "";
            btn.innerText = "Hide";
            btn.style.background = "lightpink";
        }
      }
    };
    </script>    <table border="0" style='font-family:"monospace"; font-size: 10px;'>
     <caption style='font-family:Roboto; font-size:15px; text-align:left;'>Legend</caption>
     <tr>
        <th style="min-width:100px;"><u>Kind</u></th>
        <th style="width:35%;"><u>Example</u></th>
        <th style="width: 5%; min-width:50px;"><u></u></th>
        <th style="width:60%;"><u>Description</u></th>
