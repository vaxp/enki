               uniform half4 color1;
               uniform half4 color2;
               uniform half4 color3;
               uniform half4 color4;
               uniform half4 color5;

               half4 main(half4 color) {
                   half alpha = 255.0 * color.a;
                   color = alpha < 0.5 ? color0
                         : alpha < 1.5 ? color1
                         : alpha < 2.5 ? color2
                         : alpha < 3.5 ? color3
                         : alpha < 4.5 ? color4 : color5;
                   return color;
               }
